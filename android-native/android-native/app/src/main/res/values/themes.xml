<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MockTest" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shown instantly on cold start while MainActivity restores the
         Firebase session and decides Login vs Home — this is what satisfies
         "splash/session restoration" without a fake artificial delay. -->
    <style name="Theme.MockTest.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/plum</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MockTest</item>
    </style>
</resources>
